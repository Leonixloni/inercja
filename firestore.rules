rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function zalogowany() { return request.auth != null; }
    function zwykleKonto(uid) {
      return zalogowany()
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function poprawnaOdpowiedz(uid) {
      return zwykleKonto(uid)
        && request.resource.data.keys().hasOnly(['uid', 'nazwa', 'typKonta', 'poziom', 'zrodlo', 'cel', 'zapisano'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nazwa is string
        && request.resource.data.nazwa.size() >= 1
        && request.resource.data.nazwa.size() <= 80
        && request.resource.data.typKonta == 'konto'
        && request.resource.data.poziom in ['podstawowy', 'sredni', 'zaawansowany']
        && request.resource.data.zrodlo in ['wyszukiwarka', 'social-media', 'szkola', 'znajomi', 'inne']
        && request.resource.data.cel in ['szkola', 'ciekawosc', 'praca', 'inne']
        && request.resource.data.zapisano == request.time;
    }

    function poprawneDanePostepu(uid) {
      return request.resource.data.keys().hasOnly(['uid', 'punkty', 'gwiazdki', 'lekcje', 'preferencje', 'zaktualizowano', 'misja'])
        && request.resource.data.uid == uid
        && request.resource.data.punkty is int
        && request.resource.data.punkty >= 0
        && request.resource.data.punkty <= 100000000
        && request.resource.data.gwiazdki is int
        && request.resource.data.gwiazdki >= 0
        && request.resource.data.lekcje is map
        && request.resource.data.lekcje.size() <= 1000
        && request.resource.data.preferencje is map
        && (
          request.resource.data.preferencje.size() == 0
          || (request.resource.data.preferencje.keys().hasOnly(['poziom', 'zrodlo', 'cel'])
            && request.resource.data.preferencje.keys().hasAll(['poziom', 'zrodlo', 'cel'])
            && request.resource.data.preferencje.poziom in ['podstawowy', 'sredni', 'zaawansowany']
            && request.resource.data.preferencje.zrodlo in ['wyszukiwarka', 'social-media', 'szkola', 'znajomi', 'inne']
            && request.resource.data.preferencje.cel in ['szkola', 'ciekawosc', 'praca', 'inne'])
        )
        && request.resource.data.zaktualizowano == request.time
        && (!request.resource.data.keys().hasAny(['misja']) || request.resource.data.misja in ['pierwsza_lekcja','trzy_lekcje','sto_punktow','seria_poprawnych','youtube_subskrypcja']);
    }

    function poprawnaMisja() {
      return zwykleKonto(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid','wykonane','ostatniaMisja','zaktualizowano'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.wykonane is map
        && request.resource.data.ostatniaMisja in ['pierwsza_lekcja','trzy_lekcje','sto_punktow','seria_poprawnych','youtube_subskrypcja']
        && request.resource.data.zaktualizowano == request.time;
    }

    match /odpowiedzi/{uid} {
      allow read: if false;
      allow create, update: if poprawnaOdpowiedz(uid);
      allow delete: if zwykleKonto(uid);
    }

    match /postepy/{uid} {
      allow read: if zwykleKonto(uid);
      allow create: if zwykleKonto(uid) && poprawneDanePostepu(uid) && request.resource.data.gwiazdki == 5;
      allow update: if zwykleKonto(uid)
        && poprawneDanePostepu(uid)
        && request.resource.data.punkty >= resource.data.punkty
        && (
          request.resource.data.gwiazdki <= resource.data.gwiazdki
          || (
            request.resource.data.gwiazdki > resource.data.gwiazdki
            && request.resource.data.keys().hasAny(['misja'])
            && getAfter(/databases/$(database)/documents/misje/$(uid)).data.ostatniaMisja == request.resource.data.misja
          )
        );
      allow delete: if zwykleKonto(uid);
    }

    match /misje/{uid} {
      allow read: if zwykleKonto(uid);
      allow create, update: if poprawnaMisja()
        && request.resource.data.ostatniaMisja in ['pierwsza_lekcja','trzy_lekcje','sto_punktow','seria_poprawnych','youtube_subskrypcja']
        && (!resource.exists() || !resource.data.wykonane.keys().hasAny([request.resource.data.ostatniaMisja]));
      allow delete: if false;
    }
  }
}
